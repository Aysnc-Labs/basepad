{
	"name": "@aysnc-labs/basepad",
	"version": "0.0.0",
	"description": "Local services for any project, run natively through mise and shared across git worktrees.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Aysnc-Labs/basepad.git"
	},
	"bin": {
		"basepad": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"os": [
		"darwin",
		"linux"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit && npm test",
		"lint": "biome check .",
		"prepack": "npm run build",
		"test": "vitest run"
	},
	"dependencies": {
		"smol-toml": "^1.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@neondatabase/serverless": "^1.2.0",
		"@types/node": "^24.19.2",
		"@types/ws": "^8.18.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0",
		"ws": "^8.22.2"
	}
}
